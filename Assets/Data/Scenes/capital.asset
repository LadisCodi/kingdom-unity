    _lock: 2
    _until:
      _kind: 18
      _target: upgrade-go
      _amount: 0
    _exit: 0
    _stocks: 
  - _speaker: mason
    _side: 1
    _expression: 
    _text: "The sheet says what she needs. Measure twice, pay once \u2014 then upgrade!"
