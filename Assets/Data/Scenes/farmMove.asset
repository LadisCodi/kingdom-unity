  - _speaker: advisor
    _side: 0
    _expression: worried
    _text: "Oh. Oh no. A Farm works the plots one step around it, corners too \u2014
      and ours are two steps away. I measured. Twice."
    _box: auto
    _point: district:Farm
    _lock: 3
    _until:
      _kind: 1
      _target: 
      _amount: 0
    _exit: 0
    _stocks: 
