    _side: 1
    _expression: 
    _text: "So pick it up and carry it. Did it with Widow Pell\u2019s henhouse once.
      Hens weren\u2019t pleased."
    _box: auto
    _point: 
    _lock: 3
    _until:
      _kind: 1
      _target: 
      _amount: 0
    _exit: 0
    _stocks: 
  - _speaker: advisor
    _side: 0
    _expression: surprised
    _text: "Can we? \u2026We can! The guild charter says a building may be moved
      for free, as often as you like. Page forty!"
    _box: auto
    _point: 
    _lock: 3
    _until:
      _kind: 1
      _target: 
      _amount: 0
    _exit: 0
    _stocks: 
  - _speaker: villager
    _side: 1
