  - _speaker: advisor
    _side: 0
    _expression: worried
    _text: "Wood at last \u2014 and nowhere to sleep. But that shape past the trees\u2026
      the Millers\u2019 house! Clear the fog, Your Majesty!"
    _box: auto
    _point: abandoned:OldHouse
    _lock: 2
    _until:
      _kind: 39
      _target: OldHouse
      _amount: 0
    _exit: 0
    _stocks: 
  - _speaker: advisor
    _side: 0
    _expression: happy
    _text: "There it is! The roof\u2019s fallen in, but the walls are sound. Open
      it."
