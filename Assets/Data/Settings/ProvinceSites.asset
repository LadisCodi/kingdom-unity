  _lairs:
  - _id: Orcs
    _name: Orc Lair
    _description: Orcs dug in on the hillside, and bored of waiting.
    _flavour: They burn what they cannot carry. Every night the war drums draw closer
      to the town.
    _anchor: {x: 4, y: 7}
    _size: 2
    _tier: 1
    _radius: 2
    _sight: 3
