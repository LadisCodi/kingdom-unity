    _medal: {fileID: 21300000, guid: 303be125baa7ba325bf4a6a6e3c211af, type: 3}
  - _id: WolfRiders
    _name: Wolf-rider Camp
    _description: Wolf riders who reach your walls before the dust of their riding
      does.
    _flavour: They ride in at dawn, take the flocks and are gone before the dust
      settles.
    _anchor: {x: 7, y: -15}
    _size: 2
    _tier: 4
    _radius: 2
    _sight: 3
    _threat: Cavalry
    _power: 700
